{SECT 0 {EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 3551 "restart:\n\n# Comp
ute partition numbers by Euler's pentagonal recurrence.\nBuildPartitio
nTable := proc(Nmax::nonnegint)\n    local Ptab, nn, r, g, sign, total
;\n\n    Ptab := Array(0..Nmax, datatype=anything, fill=0);\n    Ptab[
0] := 1;\n\n    for nn from 1 to Nmax do\n        total := 0;\n       \+
 r := 1;\n        sign := 1;\n\n        while true do\n            g :
= iquo(r*(3*r-1), 2);\n\n            if g > nn then\n                b
reak;\n            end if;\n\n            total := total + sign*Ptab[n
n-g];\n\n            if g+r <= nn then\n                total := total
 + sign*Ptab[nn-g-r];\n            end if;\n\n            r := r+1;\n \+
           sign := -sign;\n        end do;\n\n        Ptab[nn] := tota
l;\n    end do;\n\n    return Ptab;\nend proc:\n\n# Compute M(u,nn) us
ing (2.4) with iota=1.\n# Negative partition arguments contribute zero
.\n# All calls in the verification have nn>=72.\nCrankCoeff := proc(u:
:nonnegint, nn::posint, Ptab)\n    local r, x, term, total, sign;\n\n \+
   total := 0;\n    r := 1;\n    sign := 1;\n\n    while true do\n    \+
    x := nn-r*u-iquo(r*(r-1), 2);\n\n        if x < 0 then\n          \+
  break;\n        end if;\n\n        term := Ptab[x];\n\n        if x \+
>= r then\n            term := term-Ptab[x-r];\n        end if;\n\n   \+
     total := total + sign*term;\n        r := r+1;\n        sign := -
sign;\n    end do;\n\n    return total;\nend proc:\n\n# Exact number o
f required determinants with 72 <= n <= H.\nCount42Through := proc(H::
nonnegint)\n    local q, rem3;\n\n    if H < 72 then\n        return 0
;\n    elif H <= 108 then\n        return iquo((H-72)*(H-71), 2);\n   \+
 end if;\n\n    q := iquo(H, 3);\n    rem3 := irem(H, 3);\n\n    retur
n iquo(3*q*(q-1), 2)+(rem3+1)*q-1260;\nend proc:\n\n# Verify every req
uired determinant in the chosen n-block.\nVerify42 := proc(nFirst::pos
int, nLast::posint)\n    local Ptab, nn, m, bound, left, mid, right,\n
          det, checked, expected;\n\n    if nFirst < 72 or nLast < nFi
rst or nLast >= 10^6 then\n        error \"require 72 <= nFirst <= nLa
st < 10^6\";\n    end if;\n\n    expected := Count42Through(nLast)-Cou
nt42Through(nFirst-1);\n\n    printf(\"Computing p(0),...,p(%a).\\n\",
 nLast);\n    Ptab := BuildPartitionTable(nLast);\n\n    printf(\"Part
ition table ready; %a determinants to check.\\n\",\n           expecte
d);\n\n    checked := 0;\n\n    for nn from nFirst to nLast do\n      \+
  bound := min(nn-72, iquo(nn, 3));\n\n        # Empty m-ranges requir
e no comparison.\n        if bound >= 1 then\n            left := Cran
kCoeff(0, nn, Ptab);\n            mid := CrankCoeff(1, nn, Ptab);\n\n \+
           for m from 1 to bound do\n                right := CrankCoe
ff(m+1, nn, Ptab);\n                det := mid^2-left*right;\n\n      \+
          if det < 0 then\n                    error \"FAIL: n=%1, m=%
2, determinant=%3\",\n                          nn, m, det;\n         \+
       end if;\n\n                checked := checked+1;\n\n           \+
     # Reuse the two neighboring coefficients.\n                left :
= mid;\n                mid := right;\n            end do;\n        en
d if;\n\n        if irem(nn, 1000) = 0 or nn = nLast then\n           \+
 printf(\"Completed n=%a; checked=%a.\\n\", nn, checked);\n        end
 if;\n    end do;\n\n    if checked <> expected then\n        error \"
incomplete verification: checked=%1, expected=%2\",\n              che
cked, expected;\n    end if;\n\n    printf(\"PASS: %a <= n <= %a; chec
ked %a determinants.\\n\",\n           nFirst, nLast, checked);\n\n   \+
 return [nFirst, nLast, checked, true];\nend proc:\n\n# Full range in \+
(4.2).\n# Change these two bounds to verify a smaller block.\nnFirst :
= 72:\nnLast := 50000:\n\nresult := Verify42(nFirst, nLast):" }}{PARA 
